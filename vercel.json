{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap" },
    { "source": "/robots.txt", "destination": "/robots" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
